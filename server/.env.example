# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/niyoireme?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRE=7d

# Super Admin Static Credentials (UNIQUE - change these)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ALLOW_INITIAL_ADMIN_REGISTRATION=false

# CORS - your frontend URL
CORS_ORIGIN=https://niyoiremeunitltd.vercel.app,http://localhost:3000,http://localhost:5173

# Persistent image hosting (required for uploads in production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

{
  "name": "niyoireme-unit-company",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "npm run sitemap && npm run i18n:check && npm run verify:seo && tsc --noEmit && vite build && npm run build:seo && npm run verify:pwa",
    "build:seo": "tsx scripts/postbuild-seo.ts",
    "verify:pwa": "tsx scripts/check-pwa.ts",
    "verify:seo": "tsx scripts/validate-seo.ts",
    "preview": "vite preview --port=4173",
    "clean": "rimraf dist",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/run-tests.ts",
    "test:watch": "tsx --test --watch src/utils/quotation.test.ts",
    "i18n:check": "tsx scripts/check-i18n.ts",
    "assets": "tsx scripts/generate-assets.ts",
    "sitemap": "tsx scripts/generate-sitemap.ts"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@hookform/resolvers": "^6.0.0",
    "i18next": "^25.6.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^16.0.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "rimraf": "^6.0.1",
    "sharp": "^0.34.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}

# ---------------------------------------------------------------------------
# NIYO IREME UNIT COMPANY LTD - environment configuration
# Copy this file to `.env` (or `.env.local`) and fill in the real values.
# All variables are exposed to the browser bundle (VITE_ prefix), so never
# place private API secrets here.
# ---------------------------------------------------------------------------

# Public site origin, used for canonical URLs, hreflang, sitemap and Open Graph.
VITE_SITE_URL="https://niyoiremeunitltd.vercel.app"

# Leave blank to use the same-origin Vercel API rewrite (preferred for the
# HttpOnly admin session cookie). Local development uses the Vite proxy.
VITE_API_URL=""

# Verified company email shown in the footer, contact page and email footers.
VITE_CONTACT_EMAIL=""

# --- EmailJS (contact + quotation forms) -----------------------------------
# Create a service and a template at https://dashboard.emailjs.com and paste
# the IDs below. Leave them empty to disable sending: the forms then fall back
# to phone / WhatsApp instead of failing silently.
VITE_EMAILJS_SERVICE_ID=""
VITE_EMAILJS_TEMPLATE_ID=""
VITE_EMAILJS_PUBLIC_KEY=""

# --- Social channels --------------------------------------------------------
# Paste company-approved public profile URLs. Empty values are skipped.
# WhatsApp is shown using the verified company number.
VITE_FACEBOOK_URL=""
VITE_INSTAGRAM_URL=""
VITE_TIKTOK_URL=""
VITE_YOUTUBE_URL=""
VITE_LINKEDIN_URL=""
VITE_X_URL=""

# --- Progressive web app ----------------------------------------------------
# Set to "false" to disable service-worker registration (service worker is
# skipped automatically in development anyway).
VITE_ENABLE_SW="true"

